generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Application {
  id String @id @default(cuid())
  fullName String
  whatsapp String @unique
  city String
  email String
  motivation String
  status String @default("NEW")
  notes String?
  interviewAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
